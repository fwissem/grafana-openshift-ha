# deploy.env.example - template of the PRIVATE deployment settings.
#
#   cp deploy.env.example local/deploy.env      (local/ is git-ignored)
#
# `scripts/collect-facts.sh target` pre-fills local/deploy.env.generated with
# the real values of the target cluster: review it and rename it.
# Shell syntax (sourced by bash). No secret here: passwords are generated by
# scripts/create-secrets.sh and stored only in the cluster.

# Safety: install.sh refuses to run if `oc whoami --show-server` differs.
EXPECTED_API_SERVER="https://api.cluster.example.com:6443"

# Where Grafana goes.
NAMESPACE="grafana"
RELEASE="grafana"

# Zones: label key and the TWO data zones. Nothing runs in the quorum zone.
ZONE_LABEL="topology.kubernetes.io/zone"
DATA_ZONES="datacenter-1 datacenter-2"
REPLICAS="4"

# Storage (block, replicated; never a shared/RWX class for the database).
STORAGE_CLASS="px-replicated-db"
BACKUP_STORAGE_CLASS="px-replicated-db"
DB_VOLUME_SIZE="10Gi"
BACKUP_VOLUME_SIZE="5Gi"

# Images. Pin digests for production (image@sha256:...).
POSTGRES_IMAGE="registry.redhat.io/rhel9/postgresql-16:latest"
# Optional internal proxy of Docker Hub for the Grafana image (empty = docker.io).
GRAFANA_IMAGE_REGISTRY=""

# Plugins: scripts/load-plugins.sh copies them to a shared volume, from which each
# Grafana pod copies them at start. The class must support ReadWriteMany (for
# example a Portworx class with sharedv4: "true"). A few MiB are used.
PLUGINS_STORAGE_CLASS="px-sharedv4"
PLUGINS_VOLUME_SIZE="1Gi"

# Exposure and login.
ROUTE_HOST="grafana.apps.cluster.example.com"
OAUTH_HOST="oauth-openshift.apps.cluster.example.com"
# OpenShift groups mapped to Grafana roles (everyone else logged in = Viewer).
GRAFANA_ADMIN_GROUP="grafana-admins"
GRAFANA_EDITOR_GROUP="grafana-editors"

# Monitoring objects (ServiceMonitor, PrometheusRule): needs User Workload Monitoring.
UWM_ENABLED="true"

# Helm chart, downloaded by hand and untarred into charts/grafana.
CHART_VERSION="13.3.1"
